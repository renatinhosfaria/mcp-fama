PORT=3201
API_KEY=replace-me-with-a-strong-token
# In production (Docker Swarm), mount this file into the container as /app/.env.
# Keep VAULT_PATH in the container environment as /vault; the container env overrides this file.
VAULT_PATH=/vault
RATE_LIMIT_RPM=300
GIT_AUTHOR_NAME=mcp-obsidian
GIT_AUTHOR_EMAIL=mcp@fama.local

# Sync worker (Plan 8) — replaces brain-sync.sh cron with in-process loop
SYNC_ENABLED=true
SYNC_INTERVAL_MS=30000
GIT_REMOTE=origin
GIT_BRANCH=main

# Semantic memory (optional)
SEMANTIC_ENABLED=false
SEMANTIC_DATABASE_URL=postgresql://mcp_obsidian:replace-me@semantic-postgres:5432/mcp_obsidian
OPENAI_API_KEY=
SEMANTIC_EMBEDDING_MODEL=text-embedding-3-large
SEMANTIC_EMBEDDING_DIMENSIONS=3072
SEMANTIC_MIN_SCORE=0.75
SEMANTIC_MAX_RESULTS=5
SEMANTIC_PREVIEW_CHARS=600
